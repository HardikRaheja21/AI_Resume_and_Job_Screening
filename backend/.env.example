# ============================================================================
# BACKEND ENVIRONMENT CONFIGURATION
# Copy this to .env and fill in your actual values
# ============================================================================

# DATABASE
# --------
DATABASE_URL=sqlite:///./resumes.db
# For production with PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/resume_db

# JWT AUTHENTICATION
# ------------------
JWT_SECRET_KEY=replace_with_secure_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
AUTO_DB_BOOTSTRAP=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
UPLOAD_DIR=./uploads
LOG_FILE=./logs/app.log
MAX_UPLOAD_FILE_SIZE_MB=10

# EMAIL / SMTP
# -----------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=true
EMAIL_FROM=noreply@resumeparser.com

# RELIABILITY & RETRY LOGIC
# -------------------------
WEBHOOK_TIMEOUT_SECONDS=8
WEBHOOK_RETRY_ATTEMPTS=3
WEBHOOK_RETRY_BACKOFF_SECONDS=0.8
EMAIL_RETRY_ATTEMPTS=3
EMAIL_RETRY_BACKOFF_SECONDS=1
DEAD_LETTER_DIR=./dead_letters

# INTEGRATIONS
# -----------
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
ATS_SYNC_URL=
ATS_SYNC_API_KEY=

# AI / LANGUAGE MODELS
# ------------------
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=15
MATCHER_DISABLE_EMBEDDINGS=false

# ASYNCHRONOUS PROCESSING
# -----------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_ALWAYS_EAGER=false
PROCESSING_JOB_MAX_RETRIES=3
PROCESSING_JOB_RETRY_BACKOFF_SECONDS=30
AI_TASK_TIME_LIMIT_SECONDS=300
OCR_TASK_TIME_LIMIT_SECONDS=600
EMBEDDING_TASK_TIME_LIMIT_SECONDS=300
BULK_UPLOAD_MAX_FILES=50
PROCESSING_EVENT_REDIS_ENABLED=true
PROCESSING_EVENT_CHANNEL_PREFIX=ats:processing
PROCESSING_STREAM_HEARTBEAT_SECONDS=15

# EMBEDDING & VECTOR STORE
# -------------------------
EMBEDDING_CACHE_ENABLE=true
EMBEDDING_CACHE_MODEL_NAME=all-MiniLM-L6-v2
VECTOR_DB_DIR=./vector_store
VECTOR_COLLECTION_NAME=resume_vectors
VECTOR_CHROMA_IMPL=duckdb+parquet
VECTOR_SCHEMA_VERSION=resume-vector-v1

# AI CONFIGURATION
# ----------------
AI_PROMPT_VERSION=candidate-summary-v1
MATCH_EXPLANATION_VERSION=match-explain-v1

# WORKFLOW ORCHESTRATION
# ----------------------
WORKFLOW_ORCHESTRATION_MODE=parallel
WORKFLOW_SLA_SECONDS=300
DEFAULT_WORKFLOW_NAME=resume_intelligence
DEFAULT_WORKFLOW_VERSION=resume-dag-v1

# QUEUE & GOVERNANCE
# ------------------
QUEUE_GOVERNANCE_ENABLE=true
QUEUE_MAX_DEPTH_DEFAULT=1000
QUEUE_OVERLOAD_REJECT=false
TENANT_QUEUE_ISOLATION_ENABLE=false

# COST TRACKING
# -----------
AI_INPUT_TOKEN_COST_PER_1K=0
AI_OUTPUT_TOKEN_COST_PER_1K=0

# ADAPTIVE RUNTIME
# ---------------
ADAPTIVE_RUNTIME_ENABLE=true

# POLICY ENGINE
# -----------
POLICY_ENGINE_ENABLE=true
MAX_HALLUCINATION_RISK_SCORE=0.35
MIN_EVIDENCE_SUFFICIENCY_SCORE=0.65
TENANT_FAIRNESS_ENABLE=true

# PREDICTIVE RUNTIME
# ------------------
PREDICTIVE_RUNTIME_ENABLE=true
PREDICTION_HORIZON_SECONDS=300
SLA_BREACH_RISK_THRESHOLD=0.7
QUEUE_CONGESTION_RISK_THRESHOLD=0.75

# CHAOS ENGINEERING (Optional)
# ----------------------------
CHAOS_EXPERIMENTS_ENABLE=false
SIMULATION_DEFAULT_WORKLOAD_SIZE=100

# AUTONOMOUS RUNTIME (Optional)
# ----------------------------
AUTONOMOUS_RUNTIME_ENABLE=false
AUTONOMOUS_ACTION_MIN_CONFIDENCE=0.8
AUTONOMOUS_REQUIRE_GUARDRAILS=true
MAX_AUTONOMOUS_CONCURRENCY_DELTA=2
WORKER_QUARANTINE_FAILURE_RATE_THRESHOLD=0.5

# MULTI-AGENT COORDINATION
# ----------------------
MULTI_AGENT_RUNTIME_ENABLE=true
AGENT_CONSENSUS_MIN_SCORE=0.66
SAFETY_VERIFICATION_MAX_RISK=0.35
STRATEGY_LEARNING_RATE=0.15

# EXPERIMENTATION
# ---------------
EXPERIMENT_DEFAULT_TRAFFIC_PERCENT=10

# OBSERVABILITY & TRACING
# -----------------------
OTEL_ENABLE=false
OTEL_SERVICE_NAME=resume-parser-api
OTEL_EXPORTER_OTLP_ENDPOINT=

